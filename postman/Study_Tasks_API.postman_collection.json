{
  "info": {
    "_postman_id": "c0bf2f72-a1fa-4f3e-8f56-144cd013b600",
    "name": "Study Tasks API - Assignment 6",
    "description": "Requests for all the assignment routes, plus invalid input and missing task checks. Run in order using Postman Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Create a task",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/tasks",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "tasks"
          ]
        },
        "description": "Run this first. It saves the new id in taskId for the next requests.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Finish React exercises\",\n  \"course\": \"Web Development\",\n  \"completed\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "const task = pm.response.json();",
              "pm.collectionVariables.set(\"taskId\", task.id);",
              "pm.test(\"Task has an id\", function () { pm.expect(task.id).to.be.a(\"number\"); });"
            ]
          }
        }
      ],
      "response": []
    },
